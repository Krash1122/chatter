# Copy to client/.env for local development, and set the same VITE_* names in
# the Vercel project's Environment Variables for production.
#
# Anything prefixed VITE_ is inlined into the built JavaScript and is therefore
# PUBLIC. The Pusher key is designed to be public (channel access is granted by
# the server's /api/pusher/auth endpoint, not by the key). Never put
# PUSHER_SECRET or any Cloudinary credential in a VITE_ variable.

# --- Real-time (Pusher Channels) ---
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=us2

# --- API base URL ---
# Leave unset. It defaults to "/api", which works in production (client and API
# share a Vercel deployment) and locally (Vite proxies /api to :4000).
# Only set it if you're pointing the client at an API on a different origin.
# VITE_API_URL=https://example.com/api
