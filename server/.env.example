# Copy this file to .env and fill in real values before running the server.

# --- Postgres connection ---
# Either set DATABASE_URL directly...
DATABASE_URL=postgresql://chatter_user:chatter_pass@localhost:5432/chatter

# ...or leave DATABASE_URL unset and use these instead (db.js falls back to them):
PGHOST=localhost
PGPORT=5432
PGDATABASE=chatter
PGUSER=chatter_user
PGPASSWORD=chatter_pass

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
