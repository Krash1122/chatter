# Copy this file to .env for local development.
#
# In production these same names go in the Vercel project's Environment
# Variables (Settings -> Environment Variables), NOT in a committed file.

# --- Postgres (Neon) ---
# Use the POOLED connection string from the Neon dashboard -- the host ends in
# "-pooler". The direct (non-pooled) one will run out of connections as soon as
# a few serverless instances are warm at the same time.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/chatter?sslmode=require

# ...or leave DATABASE_URL unset and use these instead, for a local Postgres:
PGHOST=localhost
PGPORT=5432
PGDATABASE=chatter
PGUSER=chatter_user
PGPASSWORD=chatter_pass

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Real-time (Pusher Channels) ---
# From the "App Keys" tab of your Pusher Channels app.
# PUSHER_KEY is the public one and must also be set as VITE_PUSHER_KEY on the
# client; PUSHER_SECRET must never reach the browser.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# --- Image uploads (Cloudinary) ---
# From the Cloudinary dashboard. The browser uploads directly to Cloudinary
# using a signature this server generates, so the secret stays here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chatter

# --- Local server only (unused on Vercel) ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
